generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ TENANCY & AUTH ============

model Org {
  id              String   @id @default(cuid())
  name            String
  currencyCode    String   @default("EGP")
  // Financial precision: all money columns are DECIMAL — exact base-10 storage
  // (no float drift). API layer converts Decimal→number at the ok() boundary
  // so the JSON contract stays numeric (see api-helpers.decToNum).
  taxPercent      Decimal  @db.Decimal(5, 2) @default(14)
  phone           String?
  address         String?
  logo            String? // data:image URL ONLY (policy enforced in settings/org API; remote http URLs rejected)
  invoiceTemplate String? // JSON blob for invoice/receipt designer
  // Server-side negative-stock policy (settings/org API). true (default) =
  // documented POS behavior: sales may drive tracked stock below zero with a
  // warning surfaced in the response. false = sales and purchase
  // cancellations are atomically rejected (409) when stock < requested — the
  // guard is a conditional UPDATE, so no read-then-write race exists.
  // Stock TRANSFERS always enforce stock >= requested regardless of this
  // flag (a transfer cannot move goods a warehouse does not have).
  allowNegativeStock Boolean @default(true)
  // ---- Tenant lifecycle (subscription control) ----
  // ACTIVE (default — grandfathered for pre-existing tenants) | PENDING (new
  // registration awaiting company approval — zero API access) | TRIAL (approved,
  // free trial with usage caps until trialEndsAt) | SUSPENDED (admin-blocked).
  // Enforcement is server-side and centralised: lib/auth.getSession refuses
  // sessions whose org is not accessible, so EVERY authenticated route is
  // covered by construction; login additionally returns a specific error code
  // so the UI can explain WHY (pending / suspended / trial-expired).
  status          String   @default("ACTIVE")
  // Trial window anchor set at approval time; NULL for ACTIVE/PENDING orgs.
  trialEndsAt     DateTime?
  approvedAt      DateTime?
  // Internal note from the platform admin (why suspended, contact info, ...).
  adminNote       String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users        User[]
  products     Product[]
  categories   Category[]
  units        Unit[]
  warehouses   Warehouse[]
  customers    Customer[]
  suppliers    Supplier[]
  invoices     Invoice[]
  vouchers     Voucher[]
  expenses     Expense[]
  transfers    Transfer[]
  counters     Counter[]
  idempotency  IdempotencyKey[]
}

// Offline-sync dedupe: one row per logical client operation (per tenant).
// Unique (orgId, key) guarantees a replayed mutation is executed at most once.
// The key value embeds the operation scope ("invoice:", "voucher:" ...) and is
// only ever replayed to the SAME userId (checked in withIdempotency()).
model IdempotencyKey {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String   // "<scope>:<clientOperationId>"
  resultId  String?  // id of the created document once the operation commits
  createdAt DateTime @default(now())

  @@unique([orgId, key])
  @@index([orgId, createdAt])
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | MANAGER | CASHIER
  active       Boolean  @default(true)
  // Bumped whenever the password changes or an admin deactivates → all
  // previously-issued session tokens become invalid immediately.
  tokenVersion Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices     Invoice[]
  vouchers     Voucher[]
  expenses     Expense[]
  idempotencyKeys IdempotencyKey[]
}

// Brute-force defense ledger: one row per FAILED login attempt (successful
// logins are never recorded, so a valid user can never be locked out by an
// attacker spamming their address). DB-backed so the per-account failure cap
// is enforced globally — it survives restarts and holds across multiple app
// instances (the in-memory limiter in api-helpers remains ONLY as a cheap
// pre-auth DoS damper). Rows are purged opportunistically after 24h.
model LoginAttempt {
  id        String   @id @default(cuid())
  email     String // normalized lowercase
  ip        String
  createdAt DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

/// DB-backed sliding-window rate-limit ledger for pre-auth abuse controls
/// (registration and future pre-auth endpoints). One row per admitted hit
/// per bucket key — being in the database it is enforced globally: it
/// survives restarts and holds across multiple app instances, while the
/// in-memory rateLimit() stays only as a cheap pre-DB DoS damper.
model RateLimitEvent {
  id        String   @id @default(cuid())
  bucketKey String
  createdAt DateTime @default(now())

  @@index([bucketKey, createdAt])
}

// Sequence numbers per tenant per doc type (INV / PUR / RCV / PMT / TRF)
model Counter {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  docKey String // e.g. "INV" | "PUR" | "RCV" | "PMT" | "TRF"
  next   Int    @default(1)

  @@unique([orgId, docKey])
}

// ============ CATALOG ============

model Category {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@index([orgId])
}

model Unit {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String // قطعة / كيلو ...
  shortName String // pcs / kg
  createdAt DateTime @default(now())

  products Product[]

  @@index([orgId])
}

model Product {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sku        String?
  barcode    String?
  name       String
  nameEn     String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cost       Decimal  @db.Decimal(14, 2) @default(0)
  price      Decimal  @db.Decimal(14, 2) @default(0)
  // minQty is a QUANTITY threshold (weight/measure products need decimals), not money.
  minQty     Decimal  @db.Decimal(14, 3) @default(0)
  trackStock Boolean  @default(true)
  imageUrl   String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  levels    StockLevel[]
  items     InvoiceItem[]
  movements StockMovement[]

  @@unique([orgId, barcode])
  @@index([orgId, name])
}

model Warehouse {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  location    String?
  isDefault   Boolean  @default(false)
  phone       String?
  createdAt   DateTime @default(now())

  levels    StockLevel[]
  invoices  Invoice[]
  outTransfers Transfer[] @relation("fromWarehouse")
  inTransfers  Transfer[] @relation("toWarehouse")

  @@index([orgId])
}

model StockLevel {
  id          String @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  qty         Decimal  @db.Decimal(14, 3) @default(0)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

// Ledger of every quantity change
model StockMovement {
  id          String   @id @default(cuid())
  orgId       String
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  qty         Decimal // signed delta (+in / -out), DECIMAL(14,3)
  kind        String // SALE | PURCHASE | SALE_CANCEL | PURCHASE_CANCEL | ADJUST_IN | ADJUST_OUT | TRANSFER_OUT | TRANSFER_IN | OPENING
  refType     String? // INVOICE | TRANSFER | ADJUSTMENT | OPENING
  refId       String?
  note        String?
  userId      String?
  createdAt   DateTime @default(now())
  // Crash-safe idempotency for stock adjustments: the scoped idempotency key
  // is embedded INSIDE the movement, in the same transaction as the
  // StockLevel write. Unique per org; NULL for non-adjustment movements
  // (sales/purchases/transfers/openings). SQLite treats NULLs as distinct in
  // a unique index, so those rows are unaffected.
  clientOperationId String?

  @@unique([orgId, clientOperationId])
  @@index([orgId, createdAt])
  @@index([productId])
}

// ============ PEOPLE ============

model Customer {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  address        String?
  openingBalance Decimal  @db.Decimal(14, 2) @default(0) // + means customer owes us
  notes          String?
  createdAt      DateTime @default(now())

  invoices  Invoice[]
  vouchers  Voucher[]

  @@index([orgId, name])
}

model Supplier {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  address        String?
  openingBalance Decimal  @db.Decimal(14, 2) @default(0) // + means we owe supplier
  notes          String?
  createdAt      DateTime @default(now())

  invoices Invoice[]
  vouchers Voucher[]

  @@index([orgId, name])
}

// ============ SALES / PURCHASES ============

model Invoice {
  id            String   @id @default(cuid())
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number        Int
  type          String // SALE | PURCHASE
  status        String   @default("UNPAID") // UNPAID | PARTIAL | PAID | CANCELLED
  // Crash-window dedupe: set (inside the creation transaction) to the scoped
  // Idempotency-Key when the client sends one. @@unique makes a replayed request
  // hit the document itself — even if the idempotency CLAIM was lost after the
  // financial COMMIT (server crash), a retry can never create a second invoice.
  clientOperationId String?
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouseId   String?
  // RESTRICT (not SetNull): a warehouse referenced by an invoice is part of
  // the financial record — deleting it must hard-fail, never silently NULL
  // the attribution. Covers the check-then-delete race in the DELETE route.
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: Restrict)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date          DateTime @default(now())
  dueDate       DateTime?
  subtotal      Decimal  @db.Decimal(14, 2) @default(0)
  discount      Decimal  @db.Decimal(14, 2) @default(0)
  taxPercent    Decimal  @db.Decimal(5, 2) @default(0)
  taxAmount     Decimal  @db.Decimal(14, 2) @default(0)
  total         Decimal  @db.Decimal(14, 2) @default(0)
  paidAmount    Decimal  @db.Decimal(14, 2) @default(0)
  costTotal     Decimal  @db.Decimal(14, 2) @default(0) // snapshot sum(qty*costAtSale) for profit
  notes         String?

  items    InvoiceItem[]
  vouchers Voucher[]

  @@unique([orgId, type, number])
  @@unique([orgId, clientOperationId])
  @@index([orgId, date])
  @@index([orgId, status])
  @@index([customerId])
  @@index([supplierId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  nameSnap    String
  unitSnap    String?
  barcodeSnap String?
  qty         Decimal  @db.Decimal(14, 3)
  price       Decimal  @db.Decimal(14, 2)
  costAtSale  Decimal  @db.Decimal(14, 2) @default(0)
  total       Decimal  @db.Decimal(14, 2)

  @@index([invoiceId])
  @@index([productId])
}

// Money documents: RECEIPT (from customer) / PAYMENT (to supplier). Auto-created when invoice is fully/partially paid.
model Voucher {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number      Int
  type        String // RECEIPT | PAYMENT
  method      String   @default("CASH") // CASH | BANK | CARD | WALLET
  amount      Decimal  @db.Decimal(14, 2)
  // Crash-window dedupe anchor (same pattern as Invoice.clientOperationId).
  clientOperationId String?
  partyType   String   @default("OTHER") // CUSTOMER | SUPPLIER | OTHER
  partyName   String? // free text for OTHER or snapshot
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  note        String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date        DateTime @default(now())

  @@unique([orgId, type, number])
  @@unique([orgId, clientOperationId])
  @@index([orgId, date])
}

model Expense {
  id       String   @id @default(cuid())
  orgId    String
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category String   @default("عام")
  amount   Decimal  @db.Decimal(14, 2)
  method   String   @default("CASH")
  note     String?
  userId   String?
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date     DateTime @default(now())

  // Crash-window dedupe anchor (same pattern as Invoice.clientOperationId).
  clientOperationId String?

  @@unique([orgId, clientOperationId])
  @@index([orgId, date])
}

// ============ STOCK OPERATIONS ============

model Transfer {
  id               String   @id @default(cuid())
  orgId            String
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number           Int
  fromWarehouseId  String
  // RESTRICT: transfers are stock-ledger history. Cascading them away (or
  // nulling their legs) when a warehouse is deleted would silently destroy
  // the audit trail; deletion must be refused instead.
  fromWarehouse    Warehouse @relation("fromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Restrict)
  toWarehouseId    String
  toWarehouse      Warehouse @relation("toWarehouse", fields: [toWarehouseId], references: [id], onDelete: Restrict)
  note             String?
  userId           String?
  createdAt        DateTime @default(now())

  // Crash-window dedupe anchor (same pattern as Invoice.clientOperationId).
  clientOperationId String?

  items TransferItem[]

  @@unique([orgId, clientOperationId])
  @@index([orgId])
}

model TransferItem {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  productName String
  qty        Decimal  @db.Decimal(14, 3)

  @@index([transferId])
}
