generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ============ TENANCY & AUTH ============

model Org {
  id              String   @id @default(cuid())
  name            String
  currencyCode    String   @default("EGP")
  taxPercent      Float    @default(14)
  phone           String?
  address         String?
  logo            String? // data URL or http URL
  invoiceTemplate String? // JSON blob for invoice/receipt designer
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  users        User[]
  products     Product[]
  categories   Category[]
  units        Unit[]
  warehouses   Warehouse[]
  customers    Customer[]
  suppliers    Supplier[]
  invoices     Invoice[]
  vouchers     Voucher[]
  expenses     Expense[]
  transfers    Transfer[]
  counters     Counter[]
}

model User {
  id           String   @id @default(cuid())
  orgId        String
  org          Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("ADMIN") // ADMIN | MANAGER | CASHIER
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  invoices     Invoice[]
  vouchers     Voucher[]
  expenses     Expense[]
}

// Sequence numbers per tenant per doc type (INV / PUR / RCV / PMT / TRF)
model Counter {
  id     String @id @default(cuid())
  orgId  String
  org    Org    @relation(fields: [orgId], references: [id], onDelete: Cascade)
  docKey String // e.g. "INV" | "PUR" | "RCV" | "PMT" | "TRF"
  next   Int    @default(1)

  @@unique([orgId, docKey])
}

// ============ CATALOG ============

model Category {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  sort      Int      @default(0)
  createdAt DateTime @default(now())

  products Product[]

  @@index([orgId])
}

model Unit {
  id        String   @id @default(cuid())
  orgId     String
  org       Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String // قطعة / كيلو ...
  shortName String // pcs / kg
  createdAt DateTime @default(now())

  products Product[]

  @@index([orgId])
}

model Product {
  id         String   @id @default(cuid())
  orgId      String
  org        Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sku        String?
  barcode    String?
  name       String
  nameEn     String?
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitId     String?
  unit       Unit?     @relation(fields: [unitId], references: [id], onDelete: SetNull)
  cost       Float    @default(0)
  price      Float    @default(0)
  minQty     Float    @default(0)
  trackStock Boolean  @default(true)
  imageUrl   String?
  notes      String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  levels    StockLevel[]
  items     InvoiceItem[]
  movements StockMovement[]

  @@index([orgId, barcode])
  @@index([orgId, name])
}

model Warehouse {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name        String
  location    String?
  isDefault   Boolean  @default(false)
  phone       String?
  createdAt   DateTime @default(now())

  levels    StockLevel[]
  invoices  Invoice[]
  outTransfers Transfer[] @relation("fromWarehouse")
  inTransfers  Transfer[] @relation("toWarehouse")

  @@index([orgId])
}

model StockLevel {
  id          String @id @default(cuid())
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  qty         Float  @default(0)

  @@unique([productId, warehouseId])
  @@index([warehouseId])
}

// Ledger of every quantity change
model StockMovement {
  id          String   @id @default(cuid())
  orgId       String
  productId   String
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String
  qty         Float // signed delta (+in / -out)
  kind        String // SALE | PURCHASE | SALE_CANCEL | PURCHASE_CANCEL | ADJUST_IN | ADJUST_OUT | TRANSFER_OUT | TRANSFER_IN | OPENING
  refType     String? // INVOICE | TRANSFER | ADJUSTMENT | OPENING
  refId       String?
  note        String?
  userId      String?
  createdAt   DateTime @default(now())

  @@index([orgId, createdAt])
  @@index([productId])
}

// ============ PEOPLE ============

model Customer {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  address        String?
  openingBalance Float    @default(0) // + means customer owes us
  notes          String?
  createdAt      DateTime @default(now())

  invoices  Invoice[]
  vouchers  Voucher[]

  @@index([orgId, name])
}

model Supplier {
  id             String   @id @default(cuid())
  orgId          String
  org            Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  address        String?
  openingBalance Float    @default(0) // + means we owe supplier
  notes          String?
  createdAt      DateTime @default(now())

  invoices Invoice[]
  vouchers Voucher[]

  @@index([orgId, name])
}

// ============ SALES / PURCHASES ============

model Invoice {
  id            String   @id @default(cuid())
  orgId         String
  org           Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number        Int
  type          String // SALE | PURCHASE
  status        String   @default("UNPAID") // UNPAID | PARTIAL | PAID | CANCELLED
  customerId    String?
  customer      Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId    String?
  supplier      Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  warehouseId   String?
  warehouse     Warehouse? @relation(fields: [warehouseId], references: [id], onDelete: SetNull)
  userId        String?
  user          User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date          DateTime @default(now())
  dueDate       DateTime?
  subtotal      Float    @default(0)
  discount      Float    @default(0)
  taxPercent    Float    @default(0)
  taxAmount     Float    @default(0)
  total         Float    @default(0)
  paidAmount    Float    @default(0)
  costTotal     Float    @default(0) // snapshot sum(qty*costAtSale) for profit
  notes         String?

  items    InvoiceItem[]
  vouchers Voucher[]

  @@unique([orgId, type, number])
  @@index([orgId, date])
  @@index([orgId, status])
  @@index([customerId])
  @@index([supplierId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  productId   String
  product     Product @relation(fields: [productId], references: [id], onDelete: Restrict)
  nameSnap    String
  unitSnap    String?
  barcodeSnap String?
  qty         Float
  price       Float
  costAtSale  Float   @default(0)
  total       Float

  @@index([invoiceId])
  @@index([productId])
}

// Money documents: RECEIPT (from customer) / PAYMENT (to supplier). Auto-created when invoice is fully/partially paid.
model Voucher {
  id          String   @id @default(cuid())
  orgId       String
  org         Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number      Int
  type        String // RECEIPT | PAYMENT
  method      String   @default("CASH") // CASH | BANK | CARD | WALLET
  amount      Float
  partyType   String   @default("OTHER") // CUSTOMER | SUPPLIER | OTHER
  partyName   String? // free text for OTHER or snapshot
  customerId  String?
  customer    Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  supplierId  String?
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  invoiceId   String?
  invoice     Invoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  note        String?
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date        DateTime @default(now())

  @@unique([orgId, type, number])
  @@index([orgId, date])
}

model Expense {
  id       String   @id @default(cuid())
  orgId    String
  org      Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  category String   @default("عام")
  amount   Float
  method   String   @default("CASH")
  note     String?
  userId   String?
  user     User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  date     DateTime @default(now())

  @@index([orgId, date])
}

// ============ STOCK OPERATIONS ============

model Transfer {
  id               String   @id @default(cuid())
  orgId            String
  org              Org      @relation(fields: [orgId], references: [id], onDelete: Cascade)
  number           Int
  fromWarehouseId  String
  fromWarehouse    Warehouse @relation("fromWarehouse", fields: [fromWarehouseId], references: [id], onDelete: Cascade)
  toWarehouseId    String
  toWarehouse      Warehouse @relation("toWarehouse", fields: [toWarehouseId], references: [id], onDelete: Cascade)
  note             String?
  userId           String?
  createdAt        DateTime @default(now())

  items TransferItem[]

  @@index([orgId])
}

model TransferItem {
  id         String   @id @default(cuid())
  transferId String
  transfer   Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  productId  String
  productName String
  qty        Float

  @@index([transferId])
}
