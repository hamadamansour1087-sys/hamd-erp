# ─────────────────────────────────────────────────────────────
#  H.A.M.D — متغيرات البيئة (PostgreSQL)
#  انسخ هذا الملف باسم .env وعدّل القيم على السيرفر
# ─────────────────────────────────────────────────────────────

# 1) قاعدة البيانات (PostgreSQL >= 14 — provider مثبّت على postgresql في prisma/schema.prisma)
#    مثال إنتاج:
#      postgresql://user:pass@host:5432/hamd?connection_limit=10&pool_timeout=20&connect_timeout=10
#    ملاحظات:
#      - connection_limit=10 لكل مثيل مناسب لـ 2–4 مثيلات؛ ما بعدها استخدم PgBouncer
#        (transaction mode + Prisma PgBouncer-compatible mode) ووجّه DATABASE_URL إليه.
#      - ملف SQLite القديم db/custom.db أرشيف غير مستخدم وقت التشغيل —
#        الاستيراد لمرة واحدة فقط عبر scripts/migrate-sqlite-to-postgres.ts (انظر docs/DATABASE-MIGRATION.md).
DATABASE_URL=

# 2) سرّ توقيع الجلسات (JWT) — إلزامي في الإنتاج (يفشل الإقلاع دون قيمة ≥ 16 حرفاً)
#    أنشئ قيمة قوية بالأمر:
#       openssl rand -base64 32
AUTH_SECRET=

# 2.5) الوثوق بالـ reverse proxy (اختياري)
#    فعّلها فقط إذا كان التطبيق خلف nginx/caddy مضبوط حسب DEPLOY.md،
#    لتُحسب محاولات الدخول لكل IP حقيقي بدل دلو واحد مشترك:
# TRUST_PROXY=true

# 3) المنفذ (اختياري — الافتراضي 3000)
# PORT=3000
