# ─────────────────────────────────────────────────────────────
#  H.A.M.D — متغيرات البيئة
#  انسخ هذا الملف باسم .env وعدّل القيم على السيرفر
# ─────────────────────────────────────────────────────────────

# 1) قاعدة البيانات (SQLite)
#    ⚠️ على السيرفر استخدم مساراً مطلقاً — نفّذ هذا السطر من مجلد المشروع:
#       echo "DATABASE_URL=\"file:$(pwd)/db/custom.db\"" > .env
#    (ملاحظة: سكربت التشغيل bun run start يضبط المسار تلقائياً وقت التشغيل)
DATABASE_URL=

# 2) سرّ توقيع الجلسات (JWT) — إلزامي في الإنتاج
#    أنشئ قيمة قوية بالأمر:
#       openssl rand -base64 32
AUTH_SECRET=

# 3) المنفذ (اختياري — الافتراضي 3000)
# PORT=3000
